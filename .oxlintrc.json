{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "ignorePatterns": ["dist/**", "dist-ssr/**", "dev-dist/**", "coverage/**"],
  "plugins": ["eslint", "unicorn", "oxc", "vue"],
  "env": {
    "browser": true,
    "es2022": true
  },
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "warn"
  }
}
